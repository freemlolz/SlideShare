{
  "name": "slidesync-local",
  "version": "0.2.0-beta.1",
  "main": "desktop/main.mjs",
  "private": true,
  "type": "module",
  "description": "Offline LAN presentation sync for phone browsers",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "desktop": "node node_modules/electron/install.js && electron .",
    "test:desktop": "node --test test/desktop/*.test.mjs",
    "desktop:icon": "node scripts/create-desktop-icon.mjs",
    "desktop:pack": "npm run desktop:icon && electron-builder --config electron-builder.json --mac --dir --publish never",
    "desktop:dist": "npm run desktop:icon && electron-builder --config electron-builder.json --mac dmg --publish never",
    "android:beta": "node scripts/build-android-beta.mjs",
    "demo": "node scripts/create-demo.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "express": "5.3.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  }
}
